# The CPU build box: charkit's builds, fits and gates off the laptop. Copy to build.env (gitignored) and fill in;
# build-provision.sh and build.sh read it. It shares the GPU box's isolated VPC, service account and bucket
# (gpu-provision.sh creates those). A second build box: a copy (build2.env) with its own VM and MACHINE_TYPE, provisioned
# with CHARKIT_BOX_ENV=infra/gcp/build2.env infra/gcp/build-provision.sh; charkit remote --box build2 uses it.
PROJECT=my-gcp-project
REGION=us-east4
ZONE=us-east4-a
VM=anim-build-1
MACHINE_TYPE=n2-standard-32         # 32 vCPU, 128 GB: about eight builds at once, or two fits and some builds
DISK_GB=200
# DISK_TYPE=pd-balanced            # (the default; a C4 takes only hyperdisk-balanced)
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud
NETWORK=anim-research               # the GPU box's VPC: no peering, no route to anything else in the project
SA_NAME=anim-gpu                    # writes its own bucket and logs, nothing else
BUCKET=gs://my-gcp-project-anim-gpu
LABELS=purpose=anim-build,app=animation-pipeline
IDLE_MINUTES=30
BLENDER_VERSION=5.2.2               # the laptop's (charkit's caches key on the Blender build)
PYTHON_VERSION=3.14
# Box control through a service account (docs/workstreams/infra-auth.md): its own gcloud config, activated with its
# key, which Google Cloud session control never makes reauthenticate. Without this line: your own gcloud login.
export CLOUDSDK_CONFIG=/path/to/the-service-accounts/gcloud-config
BOX_OWNER=my_posix_user                # the posix user who owns the box state (infra/gcp/as-owner.sh)
