# The GPU research box. Copy to gpu.env (gitignored) and fill in; gpu-provision.sh and gpu.sh read it.
PROJECT=my-gcp-project
REGION=us-east4
ZONE=us-east4-a                     # L4 and H100 here; us-east4-c adds A100-80GB and RTX PRO 6000 (L4 stocks out there)
VM=anim-gpu-1
MACHINE_TYPE=g2-standard-8          # 1x L4 (24 GB), 8 vCPU, 32 GB RAM; the GPU comes with the machine type
DISK_GB=300
IMAGE_FAMILY=pytorch-2-9-cu129-ubuntu-2204-nvidia-580   # Deep Learning VM: CUDA 12.9, driver 580, PyTorch 2.9
NETWORK=anim-research               # a VPC of its own: no peering, no route to anything else in the project
SUBNET_RANGE=10.99.0.0/24
SA_NAME=anim-gpu                    # writes its own bucket and logs, nothing else
BUCKET=gs://my-gcp-project-anim-gpu
LABELS=purpose=anim-research,app=animation-pipeline
IDLE_MINUTES=30
# Secret Manager secret holding the Hugging Face token (gated weights); the box reads it, nothing stores it
HF_SECRET=your-hf-token-secret
